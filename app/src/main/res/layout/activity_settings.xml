<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="Settings"
                android:textColor="#003366"
                android:textSize="22sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- PROFILE INFORMATION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILE INFORMATION"
                    android:textColor="#003366"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Username:"
                        android:textColor="#555555"
                        android:textSize="14sp"/>
                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@android:drawable/editbox_background_normal"
                        android:padding="8dp"
                        android:textSize="14sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Email:"
                        android:textColor="#555555"
                        android:textSize="14sp"/>
                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@android:drawable/editbox_background_normal"
                        android:padding="8dp"
                        android:inputType="textEmailAddress"
                        android:textSize="14sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnUpdateProfile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="UPDATE PROFILE"
                    android:backgroundTint="#003366"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CHANGE PASSWORD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHANGE PASSWORD"
                    android:textColor="#003366"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etCurrentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Current Password"
                    android:inputType="textPassword"
                    android:background="@android:drawable/editbox_background_normal"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="New Password (min 6 chars)"
                    android:inputType="textPassword"
                    android:background="@android:drawable/editbox_background_normal"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etConfirmNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Confirm New Password"
                    android:inputType="textPassword"
                    android:background="@android:drawable/editbox_background_normal"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CHANGE PASSWORD"
                    android:backgroundTint="#FFA000"
                    android:textColor="@android:color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- NOTIFICATION PREFERENCES -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOTIFICATION PREFERENCES"
                    android:textColor="#003366"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <CheckBox
                        android:id="@+id/cbWaterAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Water Quality Alerts"
                        android:textColor="#555555"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <CheckBox
                        android:id="@+id/cbMaintenanceAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maintenance Reminders"
                        android:textColor="#555555"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <CheckBox
                        android:id="@+id/cbSystemAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System Notifications"
                        android:textColor="#555555"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnSavePreferences"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="SAVE PREFERENCES"
                    android:backgroundTint="#4CAF50"
                    android:textColor="@android:color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- PUSH NOTIFICATION SECTION (Zahra's Module) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PUSH NOTIFICATIONS"
                    android:textColor="#003366"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Title:"
                        android:textColor="#555555"
                        android:textSize="12sp"/>
                    <EditText
                        android:id="@+id/etNotifTitle"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Notification Title"
                        android:background="@android:drawable/editbox_background_normal"
                        android:padding="8dp"/>
                </LinearLayout>

                <EditText
                    android:id="@+id/etNotifMessage"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="Notification Message"
                    android:inputType="textMultiLine"
                    android:background="@android:drawable/editbox_background_normal"
                    android:padding="8dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnSendNotification"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="SEND PUSH NOTIFICATION"
                    android:backgroundTint="#2196F3"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOTIFICATION HISTORY"
                    android:textColor="#003366"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvNotificationHistory"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvNoNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No notifications yet. Send one above."
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:visibility="gone"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- APP INFORMATION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APP INFORMATION"
                    android:textColor="#003366"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="App Version:"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvAppVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.0.0"
                        android:textColor="#003366"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="Build Date:"
                        android:textColor="#555555"/>
                    <TextView
                        android:id="@+id/tvBuildDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="June 2026"
                        android:textColor="#003366"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnClearCache"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CLEAR NOTIFICATION HISTORY"
                    android:backgroundTint="#FF9800"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnDeleteAccount"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="DELETE ACCOUNT"
                    android:backgroundTint="#CC0000"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="LOGOUT"
                    android:backgroundTint="#607D8B"
                    android:textColor="@android:color/white"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>