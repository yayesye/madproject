<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#6F6A6A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#D8D8D8"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:layout_width="wrap_content"
                android:minWidth="50dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_arrow_back"
                android:id="@+id/gobackbutton"
                android:background="#B8AFAF"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center"
                android:text="Water Usage"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:paddingRight="50dp"
                android:background="#B8AFAF" />

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today : 18 May 2026"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:padding="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:orientation="vertical"
            android:background="#F7F7F7"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Daily Water Usage"
                android:textSize="16sp"
                android:textColor="#000000" />

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:progress="65"
                android:max="100"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/txtDailyLiters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Liters"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginHorizontal="12dp"
            android:orientation="horizontal"
            android:background="#B8AFAF">

            <TextView
                android:id="@+id/txtActiveUsers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="👥 Active User\n0 Pax"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/txtUptimeHours"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🕘 Uptime Hours\n0 Hours"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#000000" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:orientation="vertical"
            android:background="#F7F7F7"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📈 Weekly Water Usage"
                android:textSize="16sp"
                android:textColor="#000000" />

            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:progress="70"
                android:max="100"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Water Consumption History"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etConsumption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Daily Water Usage (Liters)"
            android:inputType="number"
            android:layout_margin="12dp" />

        <EditText
            android:id="@+id/etUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Active Users"
            android:inputType="number"
            android:layout_marginHorizontal="12dp" />

        <EditText
            android:id="@+id/etHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Uptime Hours"
            android:inputType="numberDecimal"
            android:layout_margin="12dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Record"
            android:layout_marginHorizontal="12dp" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Record"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_margin="12dp" />

    </LinearLayout>
</ScrollView>